# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored. Never commit a real key.

# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gemini model used by every agent. Pinned in Phase 1 (see docs/progress.md).
# gemini-2.5-flash is closed to new API users (404), so don't use it.
GEMINI_MODEL=gemini-3.8-flash

# Fallback model, used only when the primary fails after retries or its daily quota
# is used up. Leave empty to disable the fallback.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Fields scoring below this confidence are marked uncertain.
# Starting value; tuned by the offline eval in Phase 12.
CONFIDENCE_THRESHOLD=0.85
